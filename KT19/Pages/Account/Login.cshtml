@page
@model LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="card auth-card">
    <h1>Вход</h1>

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="error"></div>

        <label asp-for="Input.UserName"></label>
        <input asp-for="Input.UserName" autocomplete="username" autofocus />
        <span asp-validation-for="Input.UserName" class="error"></span>

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="error"></span>

        <label class="check">
            <input asp-for="Input.RememberMe" />
            @Html.DisplayNameFor(m => m.Input.RememberMe)
        </label>

        <button type="submit" class="btn">Войти</button>
    </form>

    <p class="muted">Нет аккаунта? <a asp-page="Register">Зарегистрироваться</a></p>
</div>
